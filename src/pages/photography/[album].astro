---
import Layout from "~/layout.astro";
import Footer from "@/footer/Footer.astro";
import PhotoFooterLinks from "~/components/footer/PhotoFooterLinks.astro";
import Nav from "~/components/nav/Nav.astro";
import { LinkedInProfile, IgProfile, email } from "~/components/utils/utils";
import { albums } from "~/components/utils/photos";

import "modular-slider/modular-slider.css"; // PhotoMultiViewer needs modular-slider styles
import "@matb85/base-pack/dist/index.css";
import PhotoMultiViewer from "@matb85/astro-pack/PhotoMultiViewer.astro";
import Photo from "@matb85/astro-pack/Photo.astro";

export function getStaticPaths() {
  return albums.map(album => ({
    params: { album: album.slug },
  }));
}

const { album } = Astro.params;

const a = albums.find(a => a.slug === album);

if (!a) {
  throw new Error("Album not found");
}

const title = `${a.name} – Photography – Mateusz Bis`;
const desc = a.sessions.map(session => session.desc).join(" ");
---

<Layout title={title} description={desc}>
  <Nav
    navLinks={[]}
    socialIcons={[
      {
        href: IgProfile,
        src: "/instagram.svg",
        alt: "Instagram Icon",
      },
      {
        href: LinkedInProfile,
        src: "/linkedin.svg",
        alt: "LinkedIn Icon",
      },
    ]}
  />

  <header id="start" class="w-full text-center px-4 pt-16 md:pt-48 max-w-6xl mx-auto">
    <div class="space-y-4">
      <h1 class="font-primary text-3xl md:text-5xl lg:text-6xl mb-2">{a.name}</h1>
      <a href="/photography#albums" class="underline">Back to albums</a>
    </div>

    <div class="mt-4">
      <a href={`mailto:${email}`} class="btn inline-block px-8 py-3 text-lg font-medium">Let's collaborate</a>
    </div>
  </header>

  <section class="w-11/12 2xl:w-3/4 max-w-[120rem] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mx-auto gap-2 mt-16">
    {
      a.sessions
        .map(session => session.photos)
        .flat()
        .map((photo, i) => (
          <Photo
            className={`w-full h-full  ${photo.height > photo.width ? "row-span-2" : ""}`}
            src={photo.src}
            multi
            group={`main-${i}`}
            alt="Photo"
            sizes={[720, 1280]}
          />
        ))
    }
  </section>
  <Footer class="w-11/12 2xl:w-3/4 max-w-[120rem]">
    <PhotoFooterLinks />
  </Footer>
  <PhotoMultiViewer />
</Layout>

<script>
  import { mutations, type BasePackStoreI } from "@matb85/base-pack";

  declare global {
    interface Window {
      cpStore: BasePackStoreI;
    }
  }

  window.addEventListener("load", () => {
    const imgs = document.querySelectorAll(".MP-photo > img") as NodeListOf<HTMLImageElement>;

    for (const img of imgs) {
      mutations.addPhoto(window.cpStore, {
        src: img.dataset.minsrc!,
        srcset: img.dataset.minsrc!,
        group: img.dataset.group!,
        alt: img.alt,
      });
    }
  });
</script>
