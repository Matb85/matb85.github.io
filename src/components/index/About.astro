---
import H from "@/utils/H";

/** Short career summary; the specifics live in the Backend section's rows. */
const facts = [
  { label: "Now", value: "Software Mansion, Kraków" },
  { label: "Before", value: "CERN · ETH Zurich · AVSystem · Redinn" },
];
---

<H text="About me" />

<div class="max-w-3xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
  <p class="md:col-span-2 text-lg leading-relaxed text-primary-700">
    I'm a software engineer at <a href="https://swmansion.com" target="_blank" rel="noopener" class="link"
      >Software Mansion</a
    > in Kraków and a Computer Science student at <a
      href="https://informatyka.agh.edu.pl/en/"
      target="_blank"
      rel="noopener"
      class="link">AGH</a
    >. I started in 2020 building websites for local businesses through my own agency, and have since worked at a
    corporation, two research labs and a student startup I co-founded. Most of it was full stack, and most of it is still
    in use. The details are below, the full list is in my <a href="/resume.pdf" target="_blank" rel="noopener" class="link"
      >CV</a
    >.
  </p>

  <dl class="flex flex-col gap-4 md:border-l border-primary-200 md:pl-6 leading-relaxed">
    {
      facts.map(fact => (
        <div>
          <dt class="text-sm text-primary-500">{fact.label}</dt>
          <dd class="font-semibold">{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
