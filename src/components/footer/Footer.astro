---
/** Page footer. The default slot holds the page's one-line sign-off; the copyright line is added below it. */
interface Props {
  class?: string;
}

const { class: className = "max-w-3xl" } = Astro.props;
---

<footer class={`${className} mx-auto px-4 mt-14 pt-8 pb-16 border-t border-primary-200 text-center text-sm text-primary-600 leading-relaxed`}>
  <p><slot /></p>
  <p class="mt-3">© Mateusz Bis {new Date().getFullYear()}</p>
</footer>
